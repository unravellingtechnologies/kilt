#!/bin/sh
# Pre-commit hook to run linting and formatting checks
# Install with: ln -s ../../.githooks/pre-commit .git/hooks/pre-commit

set -e

echo "Running pre-commit checks..."

# Check if we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "Not in a git repository, skipping pre-commit hook"
    exit 0
fi

# Run gofmt check
echo "Checking code formatting..."
if ! make fmt-check > /dev/null 2>&1; then
    echo "Error: Code is not properly formatted."
    echo "Please run 'make fmt' to fix formatting issues."
    exit 1
fi

# Run go vet
echo "Running go vet..."
if ! make vet > /dev/null 2>&1; then
    echo "Error: go vet found issues."
    exit 1
fi

# Run golangci-lint (only on staged files to be faster)
echo "Running golangci-lint on staged files..."
if command -v golangci-lint > /dev/null 2>&1; then
    STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)
    if [ -n "$STAGED_GO_FILES" ]; then
        echo "$STAGED_GO_FILES" | xargs golangci-lint run --timeout=5m
    fi
else
    echo "Warning: golangci-lint not found. Install with: make lint-install"
fi

echo "Pre-commit checks passed!"
exit 0

