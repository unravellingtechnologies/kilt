vendor/

# Go workspace file
go.work
go.work.sum

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Build artifacts
dist/
bin/
build/
*.bin
kilt
kilt.exe
kilt.darwin
kilt.linux

# Test files and fixtures (keep structure, ignore generated data)
test/fixtures/*.tmp
test/fixtures/*.generated

# Environment and secrets
.env
.env.local
*.secret

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# State and backup directories (user-specific, should not be in repo)
.kilt/state/
.kilt/backup/
.kilt/cache/
.kilt/logs/

# goreleaser snapshot builds
.goreleaser/

# Coverage reports
coverage.txt
coverage.html
